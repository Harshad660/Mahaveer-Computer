<?php
// ============================================================
// config.php.example
// Copy this file to config.php and set real values.
// config.php is listed in .gitignore and must NEVER be committed.
// ============================================================
session_start();

// Load from environment variables (set via Docker / .env / server config)
$DB_HOST = getenv('DB_HOST') ?: 'db';
$DB_NAME = getenv('DB_NAME') ?: 'mahaveer_computer';
$DB_USER = getenv('DB_USER') ?: 'your_db_user';
$DB_PASS = getenv('DB_PASS') ?: 'your_strong_password_here';

function db() {
    global $DB_HOST, $DB_NAME, $DB_USER, $DB_PASS;
    static $pdo;
    if (!$pdo) {
        $pdo = new PDO(
            "mysql:host=$DB_HOST;dbname=$DB_NAME;charset=utf8mb4",
            $DB_USER,
            $DB_PASS,
            [
                PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            ]
        );
    }
    return $pdo;
}

function e($s) { return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8'); }
function auth() { if (empty($_SESSION['user_id'])) { header("Location: login.php"); exit; } }
function money($n) { return "₹" . number_format((float)$n, 2); }
?>
